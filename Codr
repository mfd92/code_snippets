import joblib
import numpy as np

from sklearn.pipeline import Pipeline
from sklearn.preprocessing import StandardScaler
from sklearn.cluster import KMeans

data = joblib.load(
    "/dbfs/hvc_segmentation/hvc_kmeans_pipeline_params.pkl"
)

scaler = StandardScaler()
scaler.mean_ = np.array(data["scaler_mean"])
scaler.scale_ = np.array(data["scaler_scale"])
scaler.n_features_in_ = len(data["scaler_mean"])

kmeans = KMeans(
    n_clusters=data["kmeans_n_clusters"]
)

kmeans.cluster_centers_ = np.array(data["kmeans_cluster_centers"])
kmeans.inertia_ = data["kmeans_inertia"]
kmeans.n_iter_ = data["kmeans_n_iter"]

pipeline = Pipeline([
    ("scaler", scaler),
    ("kmeans", kmeans)
])
